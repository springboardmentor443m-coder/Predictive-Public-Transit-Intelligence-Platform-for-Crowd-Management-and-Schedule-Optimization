{
  "info": {
    "name": "MetroFlow API",
    "description": "AI Platform for Metro Crowd Management and Scheduling — full API surface per PRD modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "System",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{base_url}}/health" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "admin@metroflow.io" },
              { "key": "password", "value": "Admin@123" }
            ]},
            "url": "{{base_url}}/auth/login"
          }
        },
        { "name": "Current Profile", "request": { "method": "GET", "url": "{{base_url}}/auth/me" } },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"new@metroflow.io\",\"full_name\":\"New Operator\",\"role\":\"operator\",\"password\":\"Secret@123\"}" },
            "url": "{{base_url}}/auth/register"
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        { "name": "List Users", "request": { "method": "GET", "url": "{{base_url}}/users/" } },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"op2@metroflow.io\",\"full_name\":\"Second Op\",\"role\":\"operator\",\"password\":\"Secret@123\"}" },
            "url": "{{base_url}}/users/"
          }
        },
        { "name": "Deactivate User", "request": { "method": "POST", "url": "{{base_url}}/users/:user_id/deactivate" } }
      ]
    },
    {
      "name": "Crowd Monitoring",
      "item": [
        { "name": "Live Density", "request": { "method": "GET", "url": "{{base_url}}/crowd/live" } },
        { "name": "Live Station", "request": { "method": "GET", "url": "{{base_url}}/crowd/live/ST01" } },
        { "name": "Heatmap", "request": { "method": "GET", "url": "{{base_url}}/crowd/heatmap" } },
        { "name": "Station History", "request": { "method": "GET", "url": "{{base_url}}/crowd/station/ST01/history?hours=24" } },
        {
          "name": "Ingest Sensor Reading (Operator)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"station_id\":\"ST01\",\"entries\":120,\"exits\":110,\"occupancy\":320}" },
            "url": "{{base_url}}/crowd/ingest"
          }
        }
      ]
    },
    {
      "name": "Scheduling",
      "item": [
        { "name": "List Schedules", "request": { "method": "GET", "url": "{{base_url}}/scheduling/schedules?limit=50" } },
        { "name": "Get Schedule", "request": { "method": "GET", "url": "{{base_url}}/scheduling/schedules/SCH-T1" } },
        {
          "name": "Create Schedule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"id\":\"SCH-PM-001\",\"train_id\":\"TR-R01\",\"station_id\":\"ST01\",\"direction\":\"northbound\",\"arrival\":\"2026-09-01T10:00:00Z\",\"departure\":\"2026-09-01T10:01:00Z\",\"headway_min\":5,\"is_peak\":\"yes\"}" },
            "url": "{{base_url}}/scheduling/schedules"
          }
        },
        { "name": "Optimization Recommendations", "request": { "method": "GET", "url": "{{base_url}}/scheduling/optimization" } },
        {
          "name": "Report Delay",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"delay_min\": 6}" },
            "url": "{{base_url}}/scheduling/delay/SCH-R01-08-ST01"
          }
        },
        {
          "name": "Apply Headway (Frequency Adjustment)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/scheduling/apply-headway/ST01"
          }
        }
      ]
    },
    {
      "name": "AI Predictions",
      "item": [
        { "name": "Crowd Forecast", "request": { "method": "GET", "url": "{{base_url}}/predictions/crowd?station_id=ST01&hours=12" } },
        { "name": "Demand Forecast", "request": { "method": "GET", "url": "{{base_url}}/predictions/demand?station_id=ST01&hours=12" } },
        { "name": "Smart Recommendations", "request": { "method": "GET", "url": "{{base_url}}/predictions/recommendations" } },
        { "name": "Traffic Patterns", "request": { "method": "GET", "url": "{{base_url}}/predictions/patterns" } },
        { "name": "Model Info (live provenance)", "request": { "method": "GET", "url": "{{base_url}}/predictions/model-info" } },
        {
          "name": "Delay Prediction (NJ XGBoost)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"line\":\"Northeast Corrdr\",\"from_station\":\"NY Penn\",\"to_station\":\"Newark Penn\",\"stop_sequence\":5,\"hour\":8,\"weekday\":1,\"scheduled_time\":\"08:30\",\"train_type\":\"NJ Transit\"}" },
            "url": "{{base_url}}/predictions/delay"
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        { "name": "List Alerts", "request": { "method": "GET", "url": "{{base_url}}/alerts/?limit=50" } },
        { "name": "Filter Alerts (type/severity/station)", "request": { "method": "GET", "url": "{{base_url}}/alerts/?type=delay&severity=high&station_id=ST01&limit=50" } },
        { "name": "Acknowledge Alert", "request": { "method": "POST", "url": "{{base_url}}/alerts/:alert_id/acknowledge" } },
        {
          "name": "Emergency Broadcast (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"type\":\"emergency\",\"severity\":\"high\",\"title\":\"Platform Closure\",\"message\":\"Platform 2 closed for maintenance.\"}" },
            "url": "{{base_url}}/alerts/broadcast"
          }
        }
      ]
    },
    {
      "name": "Stations & Users",
      "item": [
        { "name": "List Stations", "request": { "method": "GET", "url": "{{base_url}}/stations" } },
        { "name": "Get Station", "request": { "method": "GET", "url": "{{base_url}}/stations/ST01" } },
        { "name": "Update Own Profile", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"full_name\":\"Jordan Lee\"}" }, "url": "{{base_url}}/users/me" } }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        { "name": "Overview KPIs", "request": { "method": "GET", "url": "{{base_url}}/analytics/overview" } },
        { "name": "Traffic Series", "request": { "method": "GET", "url": "{{base_url}}/analytics/traffic?hours=24" } },
        { "name": "Station Performance", "request": { "method": "GET", "url": "{{base_url}}/analytics/station-performance?limit=10" } },
        { "name": "AI Insights Panel", "request": { "method": "GET", "url": "{{base_url}}/analytics/insights" } }
      ]
    }
  ]
}
