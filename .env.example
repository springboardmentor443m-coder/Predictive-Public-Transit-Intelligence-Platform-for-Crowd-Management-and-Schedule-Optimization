# ==============================================================================
# MetroFlow AI Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the system:
#   cp .env.example .env
#
# IMPORTANT: .env.example is committed to version control to document all required
# environment variables and default development settings. The actual .env file 
# contains sensitive credentials, API keys, and secrets, and MUST be kept out of 
# version control (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=metroflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URI (Used by FastAPI and Alembic)
# Internal Docker networking connects to the "postgres" service hostname:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/metroflow_db
# For local development outside Docker (e.g., localhost), use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metroflow_db

# ------------------------------------------------------------------------------
# 2. Redis Cache Configuration
# ------------------------------------------------------------------------------
# Internal Docker networking connects to the "redis" service hostname:
REDIS_URL=redis://redis:6379/0
# For local development outside Docker:
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (HMAC-SHA256)
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=metroflow-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. FastAPI Application Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME=MetroFlow
ENVIRONMENT=production
API_V1_STR=/api/v1
MODEL_PATH=crowd_prediction_rf_compressed.pkl
SKIP_HEAVY_MODEL_LOAD=false

# Allowed Cross-Origin Resource Sharing (CORS) Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 5. Frontend Configuration
# ------------------------------------------------------------------------------
# Base API URL used by the React application to reach the FastAPI backend.
# In local development / docker, the browser connects to the exposed backend port:
VITE_API_URL=http://localhost:8000/api/v1
