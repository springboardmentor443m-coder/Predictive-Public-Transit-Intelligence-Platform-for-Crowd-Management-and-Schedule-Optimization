MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0
MONGODB_DATABASE=metroflow
METROFLOW_JWT_SECRET=replace-with-a-long-random-secret
METROFLOW_ADMIN_PASSWORD=replace-with-a-strong-admin-password
METROFLOW_OPERATOR_PASSWORD=replace-with-a-strong-operator-password
METROFLOW_JWT_EXPIRY_HOURS=8
