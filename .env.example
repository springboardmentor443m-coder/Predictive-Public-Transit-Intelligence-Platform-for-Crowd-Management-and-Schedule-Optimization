# MetroFlow Module 1 Environment Configuration

# Application Setup
PROJECT_NAME="MetroFlow Intelligent Metro Operations"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="metroflow_user"
POSTGRES_PASSWORD="metroflow_password"
POSTGRES_DB="metroflow_db"

# Database Connection URL (SQLite fallback for quick local testing if set)
# DATABASE_URL="postgresql://metroflow_user:metroflow_password@localhost:5432/metroflow_db"
# DATABASE_URL="sqlite:///./metroflow.db"

# Initial Admin Credentials (used during DB initialization)
INITIAL_ADMIN_EMAIL="admin@metroflow.io"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"
INITIAL_ADMIN_NAME="MetroFlow System Admin"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Live Data Infrastructure Settings
LIVE_DATA_PROVIDER_TYPE="UNCONFIGURED" # Options: UNCONFIGURED, SIMULATED, GTFS_RT
