# ---------------------------------------------------------------------------
# MetroFlow configuration
# Copy to `.env`. NEVER commit the real `.env` (it is already git-ignored).
# ---------------------------------------------------------------------------

# development | staging | production
# In production the app REFUSES TO START if JWT_SECRET_KEY is still the
# development default, if SEED_DEMO_DATA is on, or if CORS_ORIGINS is "*".
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://metroflow:metroflow@localhost:5432/metroflow
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=metroflow-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated. Must not be "*" in production.
CORS_ORIGINS=http://localhost:3000

# Creates the demo accounts (admin@metroflow.io / Admin@123, operator@, viewer@)
# and the generated history. MUST be false in production: the passwords are
# published in the repository.
SEED_DEMO_DATA=true

# City whose trained crowd/demand models are served (seoul | hangzhou | nyc | tfl | beijing).
METROFLOW_MODEL_CITY=nyc

# Keep the realtime Socket.IO broadcast loop running.
METROFLOW_ENABLE_REALTIME=1

# Writes generated ridership/schedule rows into the live tables so the
# dashboards have data. MUST be 0 in production once a real feed is connected,
# or the simulator will overwrite real observations. The app refuses to start in
# production while this is enabled.
METROFLOW_ENABLE_SIMULATION=1
