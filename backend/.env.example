DATABASE_URL=postgresql+psycopg2://metroflow:metroflow@localhost:5432/metroflow
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=metroflow-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
# City whose Kaggle-trained crowd/demand models are served (seoul | hangzhou).
METROFLOW_MODEL_CITY=hangzhou
# Keep the realtime Socket.IO broadcast loop running (set to 0 in tests/CI).
METROFLOW_ENABLE_REALTIME=1
