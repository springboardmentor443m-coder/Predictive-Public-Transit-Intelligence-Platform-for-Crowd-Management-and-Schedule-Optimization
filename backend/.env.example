# MetroFlow Backend Configuration

# App
PROJECT_NAME=MetroFlow
API_V1_STR=/api/v1
ENVIRONMENT=development

# Database
# For local development with Postgres or fallback SQLite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metroflow_db
# SQLite fallback if local postgres is not running:
# DATABASE_URL=sqlite:///./metroflow.db

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Security / JWT
SECRET_KEY=metroflow-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Model
MODEL_PATH=../crowd_prediction_rf_compressed.pkl

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
